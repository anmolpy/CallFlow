# ==========================================
# CallFlow Environment Configuration Example
# Copy to .env and fill in secure values.
# ==========================================

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callflow
DB_USERNAME=callflow_user
DB_PASSWORD=change_me_db_password

# Docker Compose PostgreSQL superuser/init settings
POSTGRES_DB=callflow
POSTGRES_USER=callflow_user
POSTGRES_PASSWORD=change_me_db_password

# JWT Security (minimum 32-byte / 256-bit secret)
JWT_SECRET=change_me_to_a_secure_random_256_bit_secret_key_for_local_dev
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Dev Seed Users (only used when SPRING_PROFILES_ACTIVE=dev)
CALLFLOW_DEV_SEED_USERS=true
CALLFLOW_DEV_ADMIN_EMAIL=admin@callflow.local
CALLFLOW_DEV_ADMIN_PASSWORD=change_me_admin_pass
CALLFLOW_DEV_AGENT_EMAIL=agent@callflow.local
CALLFLOW_DEV_AGENT_PASSWORD=change_me_agent_pass

# Docker Compose Ports (optional overrides)
DOCKER_DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend API Base URL (for Vite dev/build; Docker builds default to /api)
VITE_API_BASE_URL=http://localhost:8080/api
